@model ASPA008_1.Models.HumanViewModel

<div class="card-box">
    <div class="d-flex justify-content-end gap-2 mb-2">
        <a class="btn btn-sm btn-outline-dark" asp-action="Delete" asp-route-id="@Model.Celebrity.Id">Delete</a>
        <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Celebrity.Id">Edit</a>
    </div>
    <div class="d-flex align-items-start gap-4">
        <img class="human-photo" src="@($"{Model.PhotosRequestPath}/{Model.Celebrity.ReqPhotoPath}")" alt="@Model.Celebrity.FullName" />
        <div class="flex-grow-1">
            <h2>@Model.Celebrity.FullName</h2>
            <div class="mb-2">@Model.Celebrity.Nationality</div>
            @foreach (var lifeevent in Model.Lifeevents)
            {
                <div>
                    @if (lifeevent.Date.HasValue)
                    {
                        <span>@lifeevent.Date.Value.ToString("dd.MM.yyyy")</span>
                    }
                    <span> @lifeevent.Description</span>
                </div>
            }
        </div>
    </div>
    <div class="mt-3">
        @foreach (var item in Model.WikiReferences)
        {
            <a class="btn btn-outline-dark btn-sm me-2 mb-2" href="@item.Value" target="_blank">@item.Key</a>
        }
    </div>
</div>
