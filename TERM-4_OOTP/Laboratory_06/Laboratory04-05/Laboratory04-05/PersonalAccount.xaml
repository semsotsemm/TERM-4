<Window x:Class="Laboratory04_05.PersonalAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bit" Height="650" Width="1000"
        Icon="/Images/Bit.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryColor}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SecondaryColor}" CornerRadius="0,20,20,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel Margin="20">
                <Button Content="← В каталог" Click="BackToCatalog_Click" 
                        Background="Transparent" BorderThickness="0" Foreground="Gray" 
                        HorizontalAlignment="Left" Margin="0,0,0,30" Cursor="Hand"/>

                <TextBlock HorizontalAlignment="Center"  Text="{DynamicResource m_Setting}"  Foreground="{DynamicResource AccentColor}" Style="{StaticResource HeaderTextBlockStyle}" Margin="0,0,0,20"/>

                <TextBlock  HorizontalAlignment="Center"  Foreground="{DynamicResource AccentColor}" Text="Язык / Language" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <StackPanel HorizontalAlignment="Center"  Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="RU" Tag="ru-RU" Click="ChangeLanguage_Click" Style="{StaticResource RoundButtonStyle}" Width="50" Height="30" Margin="0,0,10,0"/>
                    <Button Content="EN" Tag="en-US" Click="ChangeLanguage_Click" Width="50" Height="30" Style="{StaticResource RoundButtonStyle}"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource m_ThemeSetting}"  Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="‹" Click="ScrollLeft_Click" 
            Width="30" Height="40" Background="Transparent" BorderThickness="0" 
            FontSize="24" VerticalAlignment="Center" Cursor="Hand"/>

                    <ScrollViewer x:Name="ThemeScrollViewer" Grid.Column="1" 
                  HorizontalScrollBarVisibility="Hidden" 
                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ThemesPanel" Orientation="Horizontal">
                            <Button Tag="Pink" Click="ChangeTheme_Click" Width="170" Height="130" Padding="0" Margin="5" Cursor="Hand" Background="Transparent" BorderBrush="Transparent">
                                <Image Source="/Images/pink_theme.png" Stretch="Uniform" Margin="2"/>
                            </Button>
                            <Button Tag="Green" Click="ChangeTheme_Click" Width="170" Height="130" Padding="0" Margin="5" Cursor="Hand" Background="Transparent" BorderBrush="Transparent">
                                <Image Source="/Images/green_theme.png" Stretch="Uniform" Margin="2"/>
                            </Button>
                            <Button Tag="White" Click="ChangeTheme_Click" Width="170" Height="130" Padding="0" Margin="5" Cursor="Hand" Background="Transparent" BorderBrush="Transparent">
                                <Image Source="/Images/white_theme.png" Stretch="Uniform" Margin="2"/>
                            </Button>
                            <Button Tag="Dark" Click="ChangeTheme_Click" Width="170" Height="130" Padding="0" Margin="5" Cursor="Hand" Background="Transparent" BorderBrush="Transparent">
                                <Image Source="/Images/dark_theme.png" Stretch="Uniform" Margin="2"/>
                            </Button>
                            <Button Tag="Red" Click="ChangeTheme_Click" Width="170" Height="130" Padding="0" Margin="5" Cursor="Hand" Background="Transparent" BorderBrush="Transparent">
                                <Image Source="/Images/red_theme.png" Stretch="Uniform" Margin="2"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Column="2" Content="›" Click="ScrollRight_Click" 
            Width="30" Height="40" Background="Transparent" BorderThickness="0" 
            FontSize="24" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>

                <Separator Background="#F0F0F0" Margin="0,10"/>

            <Button Content="{DynamicResource m_UnLogin}"  Click="Logout_Click" 
                        Margin="0,20,0,0" Background="#FFF0F0" Foreground="Red" 
                        BorderThickness="1" BorderBrush="#FFE0E0" Padding="10" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="40,20">
            <StackPanel>

                <TextBlock Text="{DynamicResource m_Profile}" Style="{StaticResource HeaderTextBlockStyle}"  Foreground="{DynamicResource AccentColor}" Margin="0,0,0,20"/>

                <Border Background="{DynamicResource SecondaryColor}" CornerRadius="15" Padding="25" Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="100" Height="100" CornerRadius="50" 
        BorderBrush="Gray" BorderThickness="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="AvatarScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" 
                                     Storyboard.TargetProperty="ScaleX" 
                                     To="1.15" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" 
                                     Storyboard.TargetProperty="ScaleY" 
                                     To="1.15" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" 
                                     Storyboard.TargetProperty="ScaleX" 
                                     To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" 
                                     Storyboard.TargetProperty="ScaleY" 
                                     To="1" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <TextBlock Text="👤" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="25,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource m_UserName}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="14"  Foreground="{DynamicResource AccentColor}"/>
                            <TextBox x:Name="UserName" Text="admin_user_2026" Style="{StaticResource InputControlStyle}" Background="{DynamicResource PrimaryColor}"  Foreground="{DynamicResource AccentColor}" Width="400" HorizontalAlignment="Center" TextChanged="UserName_CheckLogic"/>
                            <TextBlock Text="{DynamicResource m_Email}" HorizontalAlignment="Center"  FontWeight="Bold" FontSize="14"  Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                            <TextBox x:Name="UserEmail" Text="example@bit-store.ru" Style="{StaticResource InputControlStyle}" Background="{DynamicResource PrimaryColor}"  Foreground="{DynamicResource AccentColor}" Width="400" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource m_PhoneNumber}" HorizontalAlignment="Center"  FontWeight="Bold" FontSize="14"  Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                            <TextBox x:Name="UserPhoneNumber" Text="+375296551465" Style="{StaticResource InputControlStyle}" Background="{DynamicResource PrimaryColor}"  Foreground="{DynamicResource AccentColor}" Width="400" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource m_Password}" HorizontalAlignment="Center"  FontWeight="Bold" FontSize="14"  Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                            <PasswordBox x:Name="UserPassword" Password="23242242424"  Style="{StaticResource InputControlStyle}" Background="{DynamicResource PrimaryColor}"  Foreground="{DynamicResource AccentColor}" Width="400" HorizontalAlignment="Center"/>
                            <Button Content="Сохранить изменения" Style="{DynamicResource DarkButtonStyle}" Click="ConfirmEdition"
                                    HorizontalAlignment="Center" Margin="0,15,0,0" Width="180"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource m_Basket}" Style="{StaticResource HeaderTextBlockStyle}"  Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Text="{DynamicResource m_ProductCount}" x:Name="ProductCounter" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="Gray" Margin="10,0,0,5"/>
                </DockPanel>

                <Border Background="{DynamicResource SecondaryColor}" CornerRadius="15" Padding="15">
                    <StackPanel>
                        <ListBox Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" x:Name="BasketItemsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" Margin="5">
                                        <Image Source="{Binding ImagePath}" Width="50" Height="50" DockPanel.Dock="Left" Margin="0,0,15,0"/>
                                        <Button Content="✕" Click="CancelBasketItem_Click" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}"/>
                                            <TextBlock Text="{Binding Price, StringFormat={}{0} руб.}" Foreground="{DynamicResource AccentColor}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border BorderBrush="#F0F0F0" BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="10,15,10,5">
                            <DockPanel>
                                <TextBlock Text="{DynamicResource m_ForPayment}" FontSize="18" FontWeight="Bold"  Foreground="{DynamicResource AccentColor}"/>
                                <TextBlock Text="6 600 руб." DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                           FontSize="18" FontWeight="Bold" x:Name="TotalProductsPrice" Foreground="{DynamicResource AccentColor}"/>
                            </DockPanel>
                        </Border>

                        <Button Content="{DynamicResource m_PlacingOrder}" Style="{StaticResource CheckoutButtonStyle}" 
                                Margin="0,15,0,0" Height="40" FontSize="16" Click="PlacingOrder_Click" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="LoginOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="{DynamicResource PrimaryColor}" Width="300" Padding="10"  CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Margin="20" Background="{DynamicResource PrimaryColor}">
                    <TextBlock Text="{DynamicResource m_LoginTitle}"  FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="{DynamicResource m_Login}"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource InputControlStyle}" Background="{DynamicResource SecondaryColor}"/>
                    <TextBlock Text="{DynamicResource m_Password}"/>
                    <PasswordBox x:Name="PassBox" Style="{StaticResource InputControlStyle}" Margin="0,5,0,20" Background="{DynamicResource SecondaryColor}"/>
                    <Button Content="{DynamicResource m_Enter}" Click="ConfirmLogin_Click" Height="35" Style="{StaticResource DarkButtonStyle}"/>
                    <Button Content="{DynamicResource m_Cancel}" Click="CancelLogin_Click" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" Foreground="{DynamicResource AccentColor}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>