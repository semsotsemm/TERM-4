<Window x:Class="Laboratory04_05.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Images/Bit.ico"
        Title="Bit" Height="700" Width="1300" WindowStartupLocation="CenterScreen">
    <Grid Background="#F0F2F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#4E73DF">
            <StackPanel VerticalAlignment="Center" Margin="40">
                <TextBlock Text="Добро пожаловать в Bit" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Ввойдите в системы" Foreground="#E0E0E0" FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" Padding="40">
            <Grid>
                <StackPanel x:Name="RegisterForm" Visibility="Visible" VerticalAlignment="Center">
                    <TextBlock Text="Создать аккаунт" FontSize="26" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Имя пользователя"/>
                    <TextBox x:Name="TxtRegUsername" Height="30" Margin="0,5,0,10"/>

                    <TextBlock Text="Email"/>
                    <TextBox x:Name="TxtRegEmail" Height="30" Margin="0,5,0,10"/>

                    <TextBlock Text="Телефон"/>
                    <TextBox x:Name="TxtRegPhone" Height="30" Margin="0,5,0,10"/>

                    <TextBlock Text="Пароль"/>
                    <PasswordBox x:Name="TxtRegPassword" Height="30" Margin="0,5,0,20"/>

                    <Button Content="Зарегистрироваться" Height="35" Background="#4E73DF" Foreground="White" Click="CreateAccount"/>
                    <Button Content="Войти в аккаунт" Background="Transparent" BorderThickness="0" Foreground="#4E73DF" Click="ShowLoginForm" Margin="0,10"/>
                </StackPanel>

                <StackPanel x:Name="LoginForm" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Вход в систему" FontSize="26" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Логин или Email"/>
                    <TextBox x:Name="TxtLoginIdentifier" Height="30" Margin="0,5,0,10"/>

                    <TextBlock Text="Пароль"/>
                    <PasswordBox x:Name="TxtLoginPassword" Height="30" Margin="0,5,0,20"/>

                    <Button Content="Войти" Height="35" Background="#2ECC71" Foreground="White" Click="LoginUser"/>

                    <Grid Margin="0,10">
                        <Button Content="Регистрация" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Click="ShowRegisterForm"/>
                        <Button Content="Вход для Admin" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#E74C3C" Click="ShowAdminForm"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="AdminForm" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Вход для Admin" FontSize="26" FontWeight="Bold" Foreground="#E74C3C" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Имя администратора"/>
                    <TextBox x:Name="TxtAdminName" Height="30" Margin="0,5,0,10"/>

                    <TextBlock Text="Пароль"/>
                    <PasswordBox x:Name="TxtAdminPassword" Height="30" Margin="0,5,0,20"/>

                    <Button Content="Войти" Height="35" Background="#E74C3C" Foreground="White" Click="LoginAdmin"/>
                    <Button Content="Назад" Background="Transparent" BorderThickness="0" Click="ShowLoginForm" Margin="0,10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>