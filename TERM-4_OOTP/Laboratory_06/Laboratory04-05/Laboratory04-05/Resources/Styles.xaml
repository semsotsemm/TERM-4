<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="PrimaryDarkColor" Color="#333333"/>

    <!-- Главный текст -->
    <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter  Property ="FontWeight" Value="Bold" /> 
    </Style>
    
    <!-- Второстепенный текст -->
    <Style x:Key="ParagraphBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Инпут поля -->
    <Style TargetType="Control" x:Key="InputControlStyle">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="0,5,0,15"/>
    </Style>

    <!-- Темная кнопка -->
    <Style x:Key="DarkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryDarkColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="8" 
                        BorderBrush="White"
                        BorderThickness="0"
                        SnapsToDevicePixels="True">

                        <Border.Effect>
                            <DropShadowEffect x:Name="shadow" BlurRadius="8" ShadowDepth="1" Opacity="0.2"/>
                        </Border.Effect>

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsFocused" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                            <Setter TargetName="btnBorder" Property="BorderThickness" Value="2"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Иконка на рег -->

    <!-- Цены в корзине -->

    <Style x:Key="CheckoutButtonStyle" TargetType="Button">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=ProductCounter, Path=Text}" Value="0 товаров">
                <Setter Property="IsEnabled" Value="False"/>
                <Setter Property="Opacity" Value="0.5"/>
                <Setter Property="Background" Value="Gray"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Лист бокс -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
    <Style x:Key="RoundButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="circle" Fill="#333333" Stroke="White" StrokeThickness="2"/>

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="circle" Property="Fill" Value="OrangeRed"/>
                            <Setter TargetName="circle" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="OrangeRed" BlurRadius="15" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

 
</ResourceDictionary>