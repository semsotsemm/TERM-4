<Window x:Class="Laboratory04_05.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboratory04_05"
        mc:Ignorable="d"
        
        Icon="/Images/Bit.ico"
        Title="Bit" Height="800" Width="1200">
    <Grid  Background="{DynamicResource PrimaryColor}">
        <Grid Background="{DynamicResource SecondaryColor}" Width="300" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource m_Catalog}" Style="{StaticResource HeaderTextBlockStyle}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <ListBox BorderThickness="0" Background="Transparent" x:Name="UserPanel" SelectionChanged="AdminPanel_SelectionChanged">
                    <ListBoxItem Content="{DynamicResource m_All}" Tag="All" IsSelected="True"/>
                    <ListBoxItem Content="{DynamicResource m_Keyboards}" Tag="Клавиатуры"/>
                    <ListBoxItem Content="{DynamicResource m_Mice}" Tag="Мышки"/>
                    <ListBoxItem Content="{DynamicResource m_Headphones}" Tag="Наушники"/>
                    <ListBoxItem Content="{DynamicResource m_Monitors}" Tag="Мониторы"/>
                </ListBox>

                <Separator Margin="20,10" Background="LightGray"/>

                <StackPanel Margin="20,0">
                    <TextBlock Text="{DynamicResource m_Search}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputControlStyle}" Background="{DynamicResource PrimaryColor}" TextChanged="FilterElement_Changed"/>

                    <TextBlock Text="{DynamicResource m_Price}" FontWeight="SemiBold" Margin="0,10,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MinPriceBox" Grid.Column="0" Style="{StaticResource InputControlStyle}" Background="{DynamicResource PrimaryColor}" TextChanged="FilterElement_Changed"/>
                        <TextBlock Text="-" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox x:Name="MaxPriceBox" Grid.Column="2" Style="{StaticResource InputControlStyle}" Background="{DynamicResource PrimaryColor}" TextChanged="FilterElement_Changed"/>
                    </Grid>
                    <Button Content="{DynamicResource m_Reset}" Click="ResetFilters_Click" Margin="0,5" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="Gray" Cursor="Hand"/>
                    <TextBlock Text="{DynamicResource m_ProductManipulate}"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#333"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"/>
                    <ListBox BorderThickness="0" Background="Transparent" Margin="0, 0, 0, 50">
                        <ListBoxItem Content="{DynamicResource m_AddProduct}" Tag="AddProduct" Selected="AddProduct" Padding="10,5" FontSize="16"/>
                        <ListBoxItem Content="{DynamicResource m_DeleteProduct}" x:Name="DeleteBtn" IsEnabled="False" MouseLeftButtonUp="DeleteProduct_Click" Tag="DeleteProduct" Padding="10,5" FontSize="16"/>
                        <ListBoxItem Content="{DynamicResource m_EditProduct}" x:Name="EditBtn" IsEnabled="False" MouseLeftButtonUp="EditProduct_Click" Tag="EditProduct" Padding="10,5" FontSize="16"/>
                    </ListBox>
                </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1" BorderThickness="0" x:Name="AdminPanel" Background="Transparent" Margin="0,0,0,20">
                <ListBoxItem Content="{DynamicResource m_UnLogin}" 
 Tag="Admin" 
 FontSize="14" 
 Padding="10"
 HorizontalContentAlignment="Center"
 Background="{DynamicResource SecondaryColor}" 
 Selected="User_Selected"
 Margin="10,0"/>
            </ListBox>
        </Grid>

        <Grid x:Name="AddProductOverlay" Visibility="Collapsed" Background="#80000000" Panel.ZIndex="10">
            <Border Background="White" 
        Width="300" 
        Padding="10"
        CornerRadius="10" 
        VerticalAlignment="Center" 
        HorizontalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Добавление товара" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="Название:"/>
                        <TextBox x:Name="NameBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Описание:"/>
                        <TextBox x:Name="DescriptionBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Короткое описание:"/>
                        <TextBox x:Name="ShortDescriptionBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Рейтинг:"/>
                        <TextBox x:Name="RatingBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Количество:"/>
                        <TextBox x:Name="QuantityBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Размер:"/>
                        <TextBox x:Name="SizeBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Цвет:"/>
                        <TextBox x:Name="ColorBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Страна производства:"/>
                        <TextBox x:Name="ProductionCountryBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Скидка:"/>
                        <TextBox x:Name="DiscountBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Цена:"/>
                        <TextBox x:Name="PriceBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Категория:"/>
                        <TextBox x:Name="CategoryBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Ссылка на изображение:"/>
                        <TextBox x:Name="ImagePathBox" Margin="0,5,0,15" Padding="5"/>


                        <Button x:Name="addFinalBtn" Content="Добавить" Click="Add_Click" Height="35" Background="#333" Foreground="White"  Visibility="Collapsed"/>
                        <Button x:Name="EditFinalBtn" Content="Сохранить изменения" Click="SaveEdit_Click" Height="35" Background="#007ACC" Foreground="White" Visibility="Collapsed"/>
                        <Button Content="Отмена" Click="CancelLogin_Click" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid>
            <ScrollViewer Grid.Column="1" Margin="310,20,20,20">
                <ItemsControl x:Name="ProductsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:AdminProductCard EditClicked="AdminProductCard_EditClicked" 
                                DeleteClicked="AdminProductCard_DeleteClicked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
