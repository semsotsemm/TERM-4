<UserControl x:Class="Laboratory04_05.ProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="250" Margin="10">
    <Border x:Name="CardBorder" Background="{DynamicResource SecondaryColor}" 
            CornerRadius="10" Padding="15" Cursor="Hand" MouseLeftButtonUp="Border_MouseLeftButtonUp"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>

        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <StackPanel>
            <Image Source="{Binding ImagePath}" Height="150" Stretch="Uniform" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ShortDescription}" Foreground="{DynamicResource AccentColor}" 
                       Margin="0,0,0,10" TextWrapping="Wrap" MaxHeight="40"/>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Рейтинг: " Foreground="#debe09" FontWeight="Bold"  HorizontalAlignment="Left"/>
                <TextBlock  FontWeight="Bold" Text="{Binding Rating, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin=" 0 0 70 0 "/>
                <TextBlock FontWeight="Bold" Text="На складе:" Foreground="Gray"/>
                <TextBlock FontWeight="Bold" Text="{Binding Stock, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
            <DockPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="{Binding Price, StringFormat={}{0} руб.}"/>
                </TextBlock>
                <Button Content="{DynamicResource m_ToBasket}" HorizontalAlignment="Right" 
                        Style="{StaticResource DarkButtonStyle}" Click="BasketButton_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>