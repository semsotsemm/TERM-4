<Window x:Class="Laboratory04_05.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Images/Bit.ico"
        Title="Bit" Height="800" Width="1200">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryDarkColor" Color="#333333"/>
            <SolidColorBrush x:Key="SecondaryGrayColor" Color="#F4F4F4"/>
            <SolidColorBrush x:Key="AccentTextColor" Color="Gray"/>

            <Style TargetType="Control" x:Key="InputControlStyle">
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Margin" Value="0,5,0,15"/>
            </Style>

            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SecondaryGrayColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource m_Catalog}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <ListBox BorderThickness="0" Background="Transparent" x:Name="UserPanel" SelectionChanged="UserPanel_SelectionChanged">
                    <ListBoxItem Content="{DynamicResource m_All}" Tag="All" IsSelected="True"/>
                    <ListBoxItem Content="{DynamicResource m_Keyboards}" Tag="Клавиатуры"/>
                    <ListBoxItem Content="{DynamicResource m_Mice}" Tag="Мышки"/>
                    <ListBoxItem Content="{DynamicResource m_Headphones}" Tag="Наушники"/>
                    <ListBoxItem Content="{DynamicResource m_Monitors}" Tag="Мониторы"/>
                </ListBox>

                <Separator Margin="20,10" Background="LightGray"/>

                <StackPanel Margin="20,0">
                    <TextBlock Text="{DynamicResource m_Search}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputControlStyle}" TextChanged="FilterElement_Changed"/>

                    <TextBlock Text="{DynamicResource m_Price}" FontWeight="SemiBold" Margin="0,10,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MinPriceBox" Grid.Column="0" Style="{StaticResource InputControlStyle}" TextChanged="FilterElement_Changed"/>
                        <TextBlock Text="-" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox x:Name="MaxPriceBox" Grid.Column="2" Style="{StaticResource InputControlStyle}" TextChanged="FilterElement_Changed"/>
                    </Grid>
                    <Button Content="{DynamicResource m_Reset}" Click="ResetFilters_Click" Margin="0,5" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="Gray" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                    <Button Content="RU" Tag="ru-RU" Click="ChangeLanguage_Click" Width="50" Height="30" Background="White"/>
                    <Button Content="EN" Tag="en-US" Click="ChangeLanguage_Click" Width="50" Height="30" Background ="White"/>
                </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1" x:Name="AdminLinkList" BorderThickness="0" Background="Transparent" Margin="0,0,0,20">
                <ListBoxItem Content="{DynamicResource m_Admin}" 
                         Tag="Admin" 
                         FontSize="14" 
                         HorizontalContentAlignment="Center"
                         Selected="Admin_Selected"
                         Margin="10,0"/>
            </ListBox>
        </Grid>

        <Grid Grid.Column="1" Margin="10,20,20,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProductsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" Width="250" Margin="10" CornerRadius="10" Padding="15" MouseLeftButtonUp="Border_MouseLeftButtonUp" Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Image Source="{Binding ImagePath}" Height="150" Stretch="Uniform" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ShortDescription}" Foreground="{StaticResource AccentTextColor}" Margin="0,0,0,10" TextWrapping="Wrap" MaxHeight="40"/>
                                    <DockPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} руб.">
                                                    <Binding Path="Price"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Button Content="{DynamicResource m_ToBasket}" HorizontalAlignment="Right" Style="{StaticResource DarkButtonStyle}" Click="BasketButton_Click"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="LoginOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#80000000" Panel.ZIndex="1000">
            <Border Background="White" Width="300" Padding="10" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Margin="20">
                    <TextBlock Text="{DynamicResource m_LoginTitle}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="{DynamicResource m_Login}"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource InputControlStyle}"/>
                    <TextBlock Text="{DynamicResource m_Password}"/>
                    <PasswordBox x:Name="PassBox" Style="{StaticResource InputControlStyle}" Margin="0,5,0,20"/>
                    <Button Content="{DynamicResource m_Enter}" Click="ConfirmLogin_Click" Height="35" Style="{StaticResource DarkButtonStyle}"/>
                    <Button Content="{DynamicResource m_Cancel}" Click="CancelLogin_Click" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" Foreground="{StaticResource AccentTextColor}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>