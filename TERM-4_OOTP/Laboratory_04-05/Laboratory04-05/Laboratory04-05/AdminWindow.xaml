<Window x:Class="Laboratory04_05.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboratory04_05"
        mc:Ignorable="d"
        
        Icon="/Images/Bit.ico"
        Title="Bit" Height="800" Width="1200">
    <Grid>
        <Grid Background="#F4F4F4" Width="300" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,20,0,0">
                <TextBlock Text="Категории"
               FontSize="22"
               FontWeight="Bold"
               Foreground="#333"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>
                <ListBox BorderThickness="0" Background="Transparent" Margin="0, 0, 0, 50"  x:Name="AdminPanel"  SelectionChanged="AdminPanel_SelectionChanged">
                    <ListBoxItem Content="Все товары" Tag="All" Padding="10,5" FontSize="16"/>
                    <ListBoxItem Content="Клавиатуры" Tag="Клавиатуры" Padding="10,5" FontSize="16"/>
                    <ListBoxItem Content="Мышки" Tag="Мышки" Padding="10,5" FontSize="16"/>
                    <ListBoxItem Content="Наушники" Tag="Наушники" Padding="10,5" FontSize="16"/>
                    <ListBoxItem Content="Мониторы" Tag="Мониторы" Padding="10,5" FontSize="16"/>
                </ListBox>
                <TextBlock Text="Управление товаром"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#333"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"/>
                <ListBox BorderThickness="0" Background="Transparent" Margin="0, 0, 0, 50">
                    <ListBoxItem Content="Добавить" Tag="AddProduct" Selected="AddProduct" Padding="10,5" FontSize="16"/>
                    <ListBoxItem Content="Удалить" x:Name="DeleteBtn" IsEnabled="False" MouseLeftButtonUp="DeleteProduct_Click" Tag="DeleteProduct" Padding="10,5" FontSize="16"/>
                    <ListBoxItem Content="Редактировать" x:Name="EditBtn" IsEnabled="False" MouseLeftButtonUp="EditProduct_Click" Tag="EditProduct" Padding="10,5" FontSize="16"/>
                </ListBox>
            </StackPanel>
            <ListBox Grid.Row="1" BorderThickness="0" x:Name="UserPanel" Background="Transparent" Margin="0,0,0,20">
                <ListBoxItem Content="Пользователь" 
                 Tag="Admin" 
                 FontSize="14" 
                 Padding="10"
                 HorizontalContentAlignment="Center"
                 Background="#F4F4F4" 
                 Selected="User_Selected"
                 Margin="10,0"/>
            </ListBox>
        </Grid>

        <Grid x:Name="AddProductOverlay" Visibility="Collapsed" Background="#80000000" Panel.ZIndex="10">
            <Border Background="White" 
        Width="300" 
        Padding="10"
        CornerRadius="10" 
        VerticalAlignment="Center" 
        HorizontalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Добавление товара" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="Название:"/>
                        <TextBox x:Name="NameBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Описание:"/>
                        <TextBox x:Name="DescriptionBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Короткое описание:"/>
                        <TextBox x:Name="ShortDescriptionBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Рейтинг:"/>
                        <TextBox x:Name="RatingBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Количество:"/>
                        <TextBox x:Name="QuantityBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Размер:"/>
                        <TextBox x:Name="SizeBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Цвет:"/>
                        <TextBox x:Name="ColorBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Страна производства:"/>
                        <TextBox x:Name="ProductionCountryBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Скидка:"/>
                        <TextBox x:Name="DiscountBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Цена:"/>
                        <TextBox x:Name="PriceBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Категория:"/>
                        <TextBox x:Name="CategoryBox" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Ссылка на изображение:"/>
                        <TextBox x:Name="ImagePathBox" Margin="0,5,0,15" Padding="5"/>


                        <Button x:Name="addFinalBtn" Content="Добавить" Click="Add_Click" Height="35" Background="#333" Foreground="White"  Visibility="Collapsed"/>
                        <Button x:Name="EditFinalBtn" Content="Сохранить изменения" Click="SaveEdit_Click" Height="35" Background="#007ACC" Foreground="White" Visibility="Collapsed"/>
                        <Button Content="Отмена" Click="CancelLogin_Click" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid>
            <ScrollViewer Grid.Column="1" Margin="310,20,20,20">
                <ItemsControl x:Name="ProductsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ProductBorder" 
                                    Background="White" 
                                    Width="250" Margin="10" 
                                    CornerRadius="10" Padding="15" 
                                    MouseLeftButtonDown="Product_Select" 
                                    Cursor="Hand"
                                    BorderThickness="2"
                                    BorderBrush="Transparent">          
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                                </Border.Effect>

                                <StackPanel>
                                    <Image Source="{Binding ImagePath}" Height="150" Stretch="Uniform" Margin="0,0,0,10"/>

                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding ShortDescription}" Foreground="Gray" Margin="0,0,0,10" TextWrapping="Wrap" MaxHeight="40"/>

                                    <DockPanel>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0} руб.}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
